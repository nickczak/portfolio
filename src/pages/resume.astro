---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import Divider from "../components/Divider.astro";
import Footer from "../components/Footer.astro";

interface Entry {
  role: string;
  org?: string;
  meta?: string;
  dates: string;
  bullets?: string[];
}

interface ContactItem {
  text: string;
  href?: string;
}

const contact: ContactItem[] = [
  { text: "Eldersburg, MD 21784" },
  { text: "(443) 586.6341" },
  { text: "nlsobchak@gmail.com", href: "mailto:nlsobchak@gmail.com" },
  { text: "Portfolio", href: "https://nickczak.github.io/portfolio/" },
  { text: "LinkedIn", href: "https://www.linkedin.com/in/nicholas-sobchak-b4aa2a329" },
  { text: "GitHub", href: "https://github.com/nickczak" },
  { text: "U.S. Citizen" },
];

const experience: Entry[] = [
  {
    role: "Founding Software Developer",
    org: "ZipTip",
    meta: "Remote / Westminster, MD",
    dates: "Dec 2025 – Present",
    bullets: [
      "Designed a serverless scan API with AWS Lambda, API Gateway, and DynamoDB, implementing authentication, custom-domain routing, and ID-to-account redirects for a real-time tipping platform.",
      "Built AWS SAM CI/CD pipelines with OIDC authentication, automated Route 53 DNS updates, and rollback support for development and production environments.",
      "Built unit and integration tests with pytest for backend services and automated AWS SAM deployments.",
      "Refactored Angular services and typed API clients; introduced shared linting tooling across the codebase."
    ]
  }
];

const skills = [
  { area: "Languages", detail: "C++17, Python, Java, SQL, TypeScript, JavaScript" },
  { area: "Systems & Tools", detail: "Linux, Git, Docker, CMake, GitHub Actions, Valgrind" },
  { area: "Testing", detail: "Catch2, pytest, JUnit" },
  { area: "Backend & Data", detail: "Spring Boot, JPA, FastAPI, PostgreSQL, SQLite, DynamoDB" },
  { area: "Cloud", detail: "AWS Lambda, API Gateway, Cognito, SAM, CloudFormation, boto3" },
  { area: "Frontend", detail: "Angular, React, HTML, CSS" }
];

const projects: Entry[] = [
  {
    role: "QuickQuill",
    meta: "C++17, Java, Spring Boot, SQLite, PostgreSQL, Docker",
    dates: "",
    bullets: [
      "Built a trie-based C++ dictionary engine supporting lookup, spell-check suggestions, and autocomplete across a 1.28M-word dictionary.",
      "Used mutex synchronization for an LRU cache and thread-local SQLite connections for concurrent lookups; managed trie nodes and database handles with C++ smart pointers.",
      "Integrated the native engine with a Spring Boot REST API through Java's Foreign Function & Memory API and an extern \"C\" interface.",
      "Wrote Catch2 unit and integration tests covering data structures, dictionary operations, and concurrent lookups; packaged the native engine and Java service in a multi-stage Docker build."
    ]
  },
  {
    role: "On The Money",
    meta: "C++17, Java, Spring Boot, PostgreSQL, React, Docker",
    dates: "",
    bullets: [
      "Integrated a C++ Monte Carlo engine with a Spring Boot REST API to run 10,000 simulations per request for retirement and portfolio growth projections.",
      "Wrote Catch2 tests for percentile calculations, trajectory consistency, and simulation edge cases.",
      "Integrated Plaid Link for bank-account connections and transaction synchronization; deployed a Dockerized Java API and React PWA backed by PostgreSQL."
    ]
  }
];

const education: Entry[] = [
  {
    role: "University of Maryland, Baltimore County (UMBC)",
    org: "Bachelor of Science in Computer Science",
    meta: "Relevant coursework: Neurosymbolic AI",
    dates: "Expected May 2027",
  },
  {
    role: "Carroll Community College",
    org: "Associate of Arts in Computer Science",
    dates: "May 2025",
  },
];
---

<Layout title="RESUME — NICHOLAS SOBCHAK">
  <NavBar />
  <main class="mx-auto w-full max-w-5xl flex-1 px-6 py-16 md:px-10 md:py-24">
    <div class="mb-12 flex flex-wrap items-end justify-between gap-x-6 gap-y-4 border-b border-charcoal pb-6">
      <h1 class="font-gothic text-3xl text-bone md:text-4xl">Resume</h1>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/nicholas-sobchak-resume.pdf`}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-charcoal px-5 py-3 font-mono text-xs uppercase tracking-[0.25em] text-faded hover:border-gold hover:bg-gold/10 hover:text-gold"
        >
          [ Download PDF ]
        </a>
      </div>
    </div>

    <p class="flex flex-col gap-1 font-mono text-[11px] leading-relaxed tracking-[0.15em] text-faded uppercase sm:flex-row sm:flex-wrap sm:gap-x-2">
      {contact.map((item, i) => (
        <span>
          {item.href ? (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:border-gold hover:text-gold"
            >
              {item.text}
            </a>
          ) : (
            item.text
          )}
          {i < contact.length - 1 && <span class="hidden sm:inline">  //  </span>}
        </span>
      ))}
    </p>

    <section class="mt-12"><div class="mb-8"><Divider /></div>
      <h2 class="font-gothic text-xl text-bone md:text-2xl">Education</h2>
      {education.map((e) => (
        <article class="mt-8">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h3 class="font-mono text-sm font-bold tracking-wider text-parchment uppercase">{e.role}</h3>
            <p class="font-mono text-xs tracking-[0.2em] text-gold">{e.dates}</p>
          </div>
          <p class="mt-1 font-mono text-xs text-parchment/90">{e.org}</p>
          {e.meta && <p class="mt-1 font-mono text-xs text-faded">{e.meta}</p>}
        </article>
      ))}
    </section>

    <section class="mt-12"><div class="mb-8"><Divider /></div>
      <h2 class="font-gothic text-xl text-bone md:text-2xl">Technical Skills</h2>
      <ul class="mt-8 space-y-3 font-mono text-sm leading-relaxed text-parchment/90">
        {skills.map((s) => (
          <li class="flex flex-wrap items-baseline gap-x-3">
            <span class="text-faded" aria-hidden="true">-</span>
            <span class="font-bold tracking-wider text-parchment uppercase">{s.area}:</span>
            {s.detail}
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-12"><div class="mb-8"><Divider /></div>
      <h2 class="font-gothic text-xl text-bone md:text-2xl">Experience</h2>
      {experience.map((e) => (
        <article class="mt-8">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h3 class="font-mono text-sm font-bold tracking-wider text-parchment uppercase">
              {e.role}{e.org && ` – ${e.org}`}
            </h3>
            <p class="font-mono text-xs tracking-[0.2em] text-gold">{e.dates}</p>
          </div>
          <p class="mt-1 font-mono text-xs text-faded">{e.meta}</p>
          <ul class="mt-4 space-y-2 font-mono text-sm leading-relaxed text-parchment/90">
            {e.bullets?.map((b) => (
              <li class="flex items-baseline gap-3">
                <span class="text-faded" aria-hidden="true">-</span>
                <span set:html={b.replace(/</g, "&lt;").replace(/>/g, "&gt;")} />
              </li>
            ))}
          </ul>
        </article>
      ))}
    </section>

    <section class="mt-12"><div class="mb-8"><Divider /></div>
      <h2 class="font-gothic text-xl text-bone md:text-2xl">Technical Projects</h2>
      {projects.map((p) => (
        <article class="mt-8">
          <h3 class="font-mono text-sm font-bold tracking-wider text-parchment uppercase">{p.role}</h3>
          <p class="mt-1 font-mono text-xs text-faded">{p.meta}</p>
          <ul class="mt-4 space-y-2 font-mono text-sm leading-relaxed text-parchment/90">
            {p.bullets?.map((b) => (
              <li class="flex items-baseline gap-3">
                <span class="text-faded" aria-hidden="true">-</span>
                {b}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </section>
  </main>
  <Footer />
</Layout>
