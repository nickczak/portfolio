---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import Divider from "../components/Divider.astro";
import Footer from "../components/Footer.astro";

interface Entry {
  role: string;
  org?: string;
  meta?: string;
  dates: string;
  bullets?: string[];
}

interface ContactItem {
  text: string;
  href?: string;
}

const contact: ContactItem[] = [
  { text: "Eldersburg, MD 21784" },
  { text: "(443) 586.6341" },
  { text: "nlsobchak@gmail.com", href: "mailto:nlsobchak@gmail.com" },
  { text: "Portfolio", href: "https://nickczak.github.io" },
  { text: "LinkedIn", href: "https://www.linkedin.com/in/nicholas-sobchak-b4aa2a329" },
  { text: "GitHub", href: "https://github.com/nickczak" },
  { text: "U.S. Citizen, Eligible for U.S. Security Clearance" },
];

const experience: Entry[] = [
  {
    role: "Founding Software Developer",
    org: "ZipTip",
    meta: "Remote / Westminster, MD",
    dates: "Dec 2025 – Present",
    bullets: [
      "Designed a serverless scan API (AWS Lambda, API Gateway, DynamoDB) with custom-domain routing, authentication, and ID-to-account redirect logic for a real-time tipping platform.",
      "Upgraded a large Angular codebase with shared linting tooling, typed API clients, and service-injection refactors for a better developer experience.",
      "Built AWS SAM CI/CD pipelines with OIDC-based auth, automated Route 53 DNS propagation after deploy, and rollback support for dev and prod environments.",
      "Implemented Open Graph link previews with bot/crawler detection and pre-signed S3 URLs for rich social shares of tip links.",
    ],
  },
];

const skills = [
  { area: "JavaScript / TypeScript", detail: "Angular, React, React Native, HTML, CSS" },
  { area: "Python", detail: "FastAPI, Django, Flask, pytest" },
  { area: "Java", detail: "Spring Boot, JPA, Gradle, JUnit" },
  { area: "AWS & Cloud", detail: "Lambda, SAM CLI, boto3, Cognito, CloudFormation, API Gateway, Docker" },
  { area: "Database", detail: "PostgreSQL, DynamoDB, SQLite" },
  { area: "Tools", detail: "Git/GitHub, GitHub Actions, Linux, ESLint, Prettier, C++17 (CMake)" },
];

const projects: Entry[] = [
  {
    role: "On The Money",
    meta: "TypeScript (React/Vite PWA); Java (Spring Boot), JPA, PostgreSQL; C++ Monte Carlo engine; Docker; Plaid",
    dates: "",
    bullets: [
      "Integrated Plaid Link to let users securely connect bank accounts and automatically sync real transactions and balances through Plaid's API.",
      "Built a C++17 Monte Carlo engine running 10,000 simulations/request into a Spring Boot REST API for retirement and portfolio growth projections.",
      "Pulled live stock quotes, market indices, and symbol search via Finnhub with a per-user watchlist; shipped the frontend as a React (Vite) PWA deployed on a VPS. (see On The Money)",
    ],
  },
  {
    role: "QuickQuill",
    meta: "TypeScript (Angular); Java (Spring Boot), JPA, PostgreSQL; Docker; C++17",
    dates: "",
    bullets: [
      "Built a C++17 trie-based engine that serves lookups, spell-check suggestions, and autocomplete across a 1.28M-word dictionary using thread-local SQLite connections and a thread-safe in-memory LRU cache.",
      "Integrated the native engine into a Spring Boot REST API via Java's Panama FFM (Foreign Function & Memory) API with a flat extern \"C\" ABI — native calls with no JNI or glue code.",
      "Shipped an Angular 21 frontend with RxJS debounced search streams and ghost-text autocomplete; multi-stage Dockerized deployment of C++ engine, Spring Boot, Angular, and PostgreSQL on a free-tier VPS. (see QuickQuill)",
    ],
  },
];

const education: Entry[] = [
  {
    role: "University of Maryland, Baltimore County",
    org: "Bachelor of Science in Computer Science",
    meta: "Relevant coursework: Neurosymbolic AI",
    dates: "Aug 2025 – May 2027",
  },
  {
    role: "Carroll Community College",
    org: "Associate of Arts in Computer Science",
    dates: "Sept 2023 – May 2025",
  },
];
---

<Layout title="RESUME — NICHOLAS SOBCHAK">
  <NavBar />
  <main class="mx-auto w-full max-w-5xl flex-1 px-6 py-16 md:px-10 md:py-24">
    <div class="mb-12 flex flex-wrap items-end justify-between gap-x-6 gap-y-4 border-b border-charcoal pb-6">
      <h1 class="font-gothic text-3xl text-bone md:text-4xl">Resume</h1>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href="/mainJS_421_revised.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="border border-charcoal px-5 py-3 font-mono text-xs uppercase tracking-[0.25em] text-faded hover:border-gold hover:bg-gold/10 hover:text-gold"
        >
          [ Download PDF ]
        </a>
        <a
          href="https://github.com/nickczak/resume"
          target="_blank"
          rel="noopener noreferrer"
          class="border border-gold bg-gold/10 px-5 py-3 font-mono text-xs uppercase tracking-[0.25em] text-gold hover:border-gold hover:bg-gold/20 hover:text-gold"
        >
          [ Resume Repo ]
        </a>
      </div>
    </div>

    <p class="flex flex-col gap-1 font-mono text-[11px] leading-relaxed tracking-[0.15em] text-faded uppercase sm:flex-row sm:flex-wrap sm:gap-x-2">
      {contact.map((item, i) => (
        <span>
          {item.href ? (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:border-gold hover:text-gold"
            >
              {item.text}
            </a>
          ) : (
            item.text
          )}
          {i < contact.length - 1 && <span class="hidden sm:inline">  //  </span>}
        </span>
      ))}
    </p>

    <section class="mt-12"><div class="mb-8"><Divider /></div>
      <h2 class="font-gothic text-xl text-bone md:text-2xl">Experience</h2>
      {experience.map((e) => (
        <article class="mt-8">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h3 class="font-mono text-sm font-bold tracking-wider text-parchment uppercase">
              {e.role}{e.org && ` – ${e.org}`}
            </h3>
            <p class="font-mono text-xs tracking-[0.2em] text-gold">{e.dates}</p>
          </div>
          <p class="mt-1 font-mono text-xs text-faded">{e.meta}</p>
          <ul class="mt-4 space-y-2 font-mono text-sm leading-relaxed text-parchment/90">
            {e.bullets?.map((b) => (
              <li class="flex items-baseline gap-3">
                <span class="text-faded" aria-hidden="true">-</span>
                <span set:html={b.replace(/</g, "&lt;").replace(/>/g, "&gt;")} />
              </li>
            ))}
          </ul>
        </article>
      ))}
    </section>

    <section class="mt-12"><div class="mb-8"><Divider /></div>
      <h2 class="font-gothic text-xl text-bone md:text-2xl">Skills</h2>
      <ul class="mt-8 space-y-3 font-mono text-sm leading-relaxed text-parchment/90">
        {skills.map((s) => (
          <li class="flex flex-wrap items-baseline gap-x-3">
            <span class="text-faded" aria-hidden="true">-</span>
            <span class="font-bold tracking-wider text-parchment uppercase">{s.area}:</span>
            {s.detail}
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-12"><div class="mb-8"><Divider /></div>
      <h2 class="font-gothic text-xl text-bone md:text-2xl">Technical Projects</h2>
      {projects.map((p) => (
        <article class="mt-8">
          <h3 class="font-mono text-sm font-bold tracking-wider text-parchment uppercase">{p.role}</h3>
          <p class="mt-1 font-mono text-xs text-faded">{p.meta}</p>
          <ul class="mt-4 space-y-2 font-mono text-sm leading-relaxed text-parchment/90">
            {p.bullets?.map((b) => (
              <li class="flex items-baseline gap-3">
                <span class="text-faded" aria-hidden="true">-</span>
                {b}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </section>

    <section class="mt-12 pb-4"><div class="mb-8"><Divider /></div>
      <h2 class="font-gothic text-xl text-bone md:text-2xl">Education</h2>
      {education.map((e) => (
        <article class="mt-8">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h3 class="font-mono text-sm font-bold tracking-wider text-parchment uppercase">{e.role}</h3>
            <p class="font-mono text-xs tracking-[0.2em] text-gold">{e.dates}</p>
          </div>
          <p class="mt-1 font-mono text-xs text-parchment/90">{e.org}</p>
          {e.meta && <p class="mt-1 font-mono text-xs text-faded">{e.meta}</p>}
        </article>
      ))}
    </section>
  </main>
  <Footer />
</Layout>
