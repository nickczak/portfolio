---
import { getCollection } from "astro:content";
import Divider from "./Divider.astro";

const projects = await getCollection("projects");
---

<section class="mx-auto w-full max-w-5xl px-6 pb-14 sm:px-10" aria-label="Articles">
  <Divider />
  <p class="mt-5 text-center font-mono text-xs uppercase tracking-[0.3em] text-gold md:text-left">
    [ Articles ]
  </p>

  <div class="scrollbar-hide -mx-6 mt-8 flex gap-6 overflow-x-auto px-6 pb-4 sm:-mx-0 sm:px-0">
    {
      projects.map((project) => (
        <a
          href={`${import.meta.env.BASE_URL}/projects/${project.id}`}
          class="group flex min-w-[280px] max-w-[360px] shrink-0 flex-col gap-4 border border-charcoal p-5 transition-colors duration-200 hover:bg-charcoal/20 sm:min-w-[320px]"
        >
          <span class="absolute left-0 top-0 h-3 w-3 border-l border-t border-faded/40 transition-colors duration-200 group-hover:border-gold" aria-hidden="true" />
          <span class="absolute right-0 top-0 h-3 w-3 border-r border-t border-faded/40 transition-colors duration-200 group-hover:border-gold" aria-hidden="true" />
          <span class="absolute bottom-0 left-0 h-3 w-3 border-b border-l border-faded/40 transition-colors duration-200 group-hover:border-gold" aria-hidden="true" />
          <span class="absolute bottom-0 right-0 h-3 w-3 border-b border-r border-faded/40 transition-colors duration-200 group-hover:border-gold" aria-hidden="true" />

          <h3 class="font-gothic text-lg text-bone transition-colors duration-200 group-hover:text-gold md:text-xl">
            {project.data.title}
          </h3>

          <p class="line-clamp-3 font-academic text-sm leading-relaxed text-parchment/80 md:text-base">
            {project.data.description}
          </p>

          <div class="mt-auto flex flex-wrap gap-2 pt-2">
            {project.data.stack.slice(0, 3).map((item) => (
              <span class="border border-charcoal px-2 py-1 font-mono text-[10px] text-faded">
                {item}
              </span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
