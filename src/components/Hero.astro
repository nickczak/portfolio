---
import Divider from "./Divider.astro";
import ArticlesCarousel from "./ArticlesCarousel.astro";

const socials = [
  {
    label: "GitHub",
    href: "https://github.com/nickczak",
    path: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/nicholas-sobchak-b4aa2a329",
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
];


const skills = [
  {
    category: "Languages",
    items: ["C++", "Python", "Java", "SQL", "TypeScript", "JavaScript", "HTML", "CSS"],
  },
  {
    category: "Frameworks",
    items: [
      "Spring Boot",
      "Angular",
      "React",
      "React Native",
    ],
  },
  {
    category: "Tools & Services",
    items: [
      "Linux",
      "Git",
      "Docker",
      "AWS Lambda",
      "SAM CLI",
      "API Gateway",
      "Amazon Cognito",
      "DynamoDB",
      "PostgreSQL",
      "SQLite",
      "GitHub Actions",
    ],
  },
];
---

<section class="relative mx-auto w-full max-w-5xl flex-1 overflow-hidden px-6 pb-10 pt-12 md:px-10 md:pb-14 md:pt-24">
  <div class="relative">
    <svg
      viewBox="0 0 320 320"
      role="img"
      aria-label="Nicholas Sobchak — N family crest monogram"
      class="float-right mb-4 ml-4 h-32 w-32 text-gold sm:h-56 sm:w-56 md:mb-8 md:ml-10 md:h-80 md:w-80 lg:h-[22rem] lg:w-[22rem]"
    >
      <circle cx="160" cy="160" r="148" fill="var(--color-ink-black)" stroke="var(--color-charcoal)" />
      <!-- A fine heraldic frame and mirrored foliage leave Quotex as the focal point. -->
      <g fill="none" stroke="currentColor" stroke-linejoin="round">
        <path
          d="M 160 54 C 132 65 106 66 80 60 L 80 151 C 80 205 118 241 160 268 C 202 241 240 205 240 151 L 240 60 C 214 66 188 65 160 54 Z"
          stroke-width="1.5"
          opacity="0.75"
        />
        <path
          d="M 160 64 C 134 74 110 75 90 72 L 90 151 C 90 199 123 231 160 256 C 197 231 230 199 230 151 L 230 72 C 210 75 186 74 160 64 Z"
          stroke-width="0.75"
          opacity="0.35"
        />
      </g>
      {["translate(0 0)", "translate(320 0) scale(-1 1)"].map((transform) => (
        <g transform={transform} stroke="currentColor" stroke-width="1" opacity="0.5">
          <path d="M 145 279 C 78 256 42 202 48 130" fill="none" />
          <g fill="currentColor" stroke="none">
            <path d="M 48 153 C 33 144 32 126 37 114 C 47 124 52 139 48 153 Z" />
            <path d="M 50 183 C 35 177 28 163 29 149 C 43 156 50 169 50 183 Z" />
            <path d="M 62 214 C 45 212 33 200 31 185 C 47 189 58 200 62 214 Z" />
            <path d="M 83 241 C 66 244 52 237 45 224 C 61 222 75 228 83 241 Z" />
            <path d="M 109 261 C 95 269 78 266 67 256 C 82 249 98 252 109 261 Z" />
          </g>
        </g>
      ))}
      <g fill="none" stroke="currentColor" stroke-width="1" opacity="0.7">
        <path d="M 144 36 Q 160 45 176 36 M 160 34 V 46" />
        <path d="M 141 287 Q 160 280 179 287" />
      </g>
      <g fill="currentColor" opacity="0.85">
        <path d="M 160 20 L 165 27 L 160 34 L 155 27 Z" />
        <path d="M 160 285 L 164 291 L 160 297 L 156 291 Z" />
      </g>
      <!-- Quotex's N extends below its baseline; center its visible bounds, not its em box. -->
      <text
        x="160"
        y="215"
        text-anchor="middle"
        fill="currentColor"
        font-size="176"
        class="font-quotex"
      >N</text>
    </svg>

    <p class="mb-6 font-mono text-[11px] uppercase tracking-[0.35em] text-gold/80">
      [ ELDERSBURG, MD ]
    </p>

    <h1 class="font-gothic text-4xl font-medium text-bone sm:text-6xl [text-wrap:balance]">
      Nicholas Sobchak
    </h1>

    <p class="mt-6 font-academic text-2xl text-parchment md:text-3xl">Software Engineer</p>
    <p class="mt-2 font-mono text-xs leading-relaxed tracking-wider text-gold">
      Computer Science · UMBC · Class of 2027
    </p>
    <p class="mt-6 max-w-xl font-academic text-xl leading-relaxed text-parchment md:text-2xl">
      Building reliable software with C++, Java, Python, and modern cloud technologies.
    </p>

    <nav aria-label="Social links" class="mt-10 flex items-center gap-4">
      {
        socials.map(({ label, href, path }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            title={label}
            class="flex h-12 w-12 items-center justify-center text-faded transition-colors hover:text-gold"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
              <path d={path} />
            </svg>
          </a>
        ))
      }
    </nav>

    <div class="clear-both"></div>
  </div>
</section>

<section class="mx-auto w-full max-w-5xl px-6 pb-14 md:px-10" aria-label="Professional experience">
  <Divider />

  <div
    class="mt-5 flex items-center gap-6 border border-charcoal p-6 transition-colors duration-200 hover:bg-charcoal/20 md:gap-8 md:p-8 cursor-pointer"
    data-url={`${import.meta.env.BASE_URL}/ziptip`}
    onclick="if(event.target.closest('a'))return;window.location=this.dataset.url"
  >
    <a
      href="https://ziptip.io"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Visit ZipTip"
      title="ZipTip"
    >
      <img
        src={`${import.meta.env.BASE_URL}/ziptip-logo.png`}
        alt="ZipTip logo"
        width={499}
        height={504}
        class="h-20 w-20 object-contain transition-transform duration-200 hover:scale-105 md:h-24 md:w-24"
      />
    </a>

    <div>
      <h3 class="font-mono text-base font-bold uppercase tracking-wider text-parchment md:text-lg">
        Founding Software Developer @
        <a
          href="https://ziptip.io"
          target="_blank"
          rel="noopener noreferrer"
          class="text-bone underline decoration-charcoal underline-offset-4 transition-colors duration-200 hover:decoration-gold hover:text-gold">ZipTip</a
        >
      </h3>
      <p class="mt-2 font-mono text-xs tracking-[0.2em] text-gold md:text-sm">Dec 2025 – Present</p>
    </div>
  </div>
</section>

<section class="mx-auto w-full max-w-5xl" aria-label="Tech stack">
  <div class="mx-auto w-full max-w-5xl px-6 pb-3 sm:px-10">
    <Divider />
  </div>

  <div class="grid grid-cols-1 divide-y divide-charcoal px-6 pb-14 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-0">
      {
        skills.map(({ category, items }) => (
          <div class="pb-6 pt-1 text-center sm:text-left sm:px-8 sm:first:pl-0 sm:last:pr-0">
            <p class="font-mono text-xs uppercase tracking-[0.3em] text-gold">
              [ {category} ]
            </p>
            <p class="mt-5 font-mono text-sm leading-loose text-parchment md:text-base">
              {items.join("  ·  ")}
            </p>
          </div>
        ))
      }
    </div>
</section>

<section class="mx-auto w-full max-w-5xl px-6 pb-14 md:px-10" aria-labelledby="about-heading">
  <Divider />
  <div class="flex flex-col items-center gap-8 pt-10 sm:flex-row sm:gap-10">
    <div class="flex shrink-0 flex-col items-center gap-5">
      <h2 id="about-heading" class="font-mono text-xs uppercase tracking-[0.3em] text-gold">
        [ About Me ]
      </h2>
      <div class="w-32 rounded-t-full border border-gold/35 bg-graphite p-1 sm:w-40">
        <img
          src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/heist-logo.jpg`}
          alt="Silhouette of a figure in a hat"
          width={1125}
          height={1493}
          loading="lazy"
          decoding="async"
          class="h-auto w-full rounded-t-full"
        />
      </div>
    </div>
    <p class="max-w-2xl text-center font-academic text-xl leading-relaxed text-parchment sm:text-left md:text-2xl">
      I'm a curious person who enjoys solving problems and building practical projects.
      I love detective shows, especially <em>White Collar</em>, which inspires my interest
      in security. I'm also a musician with a fascination for classical music, and I
      currently play ice hockey at UMBC.
    </p>
  </div>
</section>

<ArticlesCarousel />

<section class="mx-auto w-full max-w-5xl px-6 pb-14 sm:px-10" aria-label="Contact">
  <Divider />
  <div class="flex flex-col items-center gap-8 pt-10 text-center md:flex-row md:items-end md:justify-between md:text-left">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-gold">
        [ Contact ]
      </p>
      <p class="mt-4 font-gothic text-2xl text-bone md:text-3xl">
        Let's build something together.
      </p>
      <p class="mt-3 font-mono text-sm tracking-wide text-faded">
        nlsobchak@gmail.com · Eldersburg, MD
      </p>
    </div>
    <a
      href="mailto:nlsobchak@gmail.com"
      class="border border-charcoal px-5 py-3 font-mono text-xs uppercase tracking-[0.25em] text-faded transition-colors duration-200 hover:border-gold hover:bg-gold/10 hover:text-gold"
    >
      [ Get In Touch ]
    </a>
  </div>
</section>
