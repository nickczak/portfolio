---
import { getCollection } from "astro:content";
import ProductCard from "./ProductCard.astro";

const featuredOrder = ["quickquill", "on-the-money", "hashword"];
const priority = (id: string) => {
  const index = featuredOrder.indexOf(id);
  return index === -1 ? featuredOrder.length : index;
};
const projects = (await getCollection("projects")).sort(
  (a, b) => priority(a.id) - priority(b.id) || a.id.localeCompare(b.id),
);
---

<section class="mx-auto w-full max-w-5xl px-6 pb-16 pt-16 md:px-10 md:pb-32 md:pt-24">
  <div class="border-b border-charcoal pb-[3px]">
    <div class="flex items-end justify-between gap-6 border-b border-charcoal pb-6">
      <h2 class="font-gothic text-3xl text-bone md:text-4xl">
        Projects
      </h2>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-10 md:gap-16">
    {projects.map((project) => (
      <ProductCard
        slug={project.id}
        name={project.data.name}
        description={project.data.description}
        stack={project.data.stack}
        href={project.data.href}
        gif={project.data.gif}
        liveHref={project.data.liveHref}
      />
    ))}
  </div>
</section>
