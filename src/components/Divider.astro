---
interface Props {
  glyph?: string;
}

const { glyph = "✦" } = Astro.props;
---

<div class="flex items-center gap-4">
  <span class="h-px flex-1 bg-charcoal" aria-hidden="true"></span>
  <span class="font-mono text-[10px] text-gold" aria-hidden="true">{glyph}</span>
  <span class="h-px flex-1 bg-charcoal" aria-hidden="true"></span>
</div>
