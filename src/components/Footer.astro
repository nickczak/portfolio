---
import Divider from "./Divider.astro";

const socials = [
  {
    label: "GitHub",
    href: "https://github.com/nickczak",
    path: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/nicholas-sobchak-b4aa2a329",
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
];

const stack = ["Astro", "TypeScript", "Tailwind CSS", "GitHub Actions"];

const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const u = (path: string) => `${BASE}${path}`;

const tabs = [
  { label: "Home", href: "/" },
  { label: "Projects", href: "/projects" },
  { label: "Resume", href: "/resume" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const cleanPath = BASE !== "" && currentPath.startsWith(BASE)
  ? currentPath.slice(BASE.length) || "/"
  : currentPath;
const isActive = (href: string) => href === cleanPath;
---

<footer class="bg-black pt-4">
  <div class="relative translate-y-px">
          <div
            class="absolute inset-x-0 top-[87.5%] h-px translate-y-px bg-parchment opacity-70"
            aria-hidden="true"
          ></div>
          <img
    src={`${import.meta.env.BASE_URL}/footer-rule.png`}
    alt=""
    loading="lazy"
    class="relative mx-auto block h-auto w-full max-w-xl select-none opacity-70"
  />
</div>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 pt-6 md:grid md:grid-cols-[1fr_auto_1fr]">
    <div class="flex items-end" role="img" aria-label="Nicholas Sobchak">
      <span
        class="flex h-12 w-12 select-none items-center justify-center rounded-full bg-black font-quotex text-4xl leading-none text-gold"
      >
        N
      </span>
      <span class="relative -ml-3 -top-1 select-none font-gothic text-2xl leading-none text-bone">icholas Sobchak</span>
    </div>
    <nav
      aria-label="Footer"
      class="order-last flex w-full basis-full justify-center pt-2 font-mono md:order-none md:w-auto md:basis-auto md:pt-0"
    >
      {
        tabs.map(({ label, href }) => (
          <a
            href={u(href)}
            aria-current={isActive(href) ? "page" : undefined}
            class={`px-4 font-mono text-xs uppercase tracking-[0.2em] transition-colors duration-200 ${
              isActive(href) ? "text-bone" : "text-faded hover:text-gold"
            }`}
          >
            {label}
          </a>
        ))
      }
    </nav>
    <nav aria-label="Social links" class="flex items-center gap-3 md:justify-self-end">
      {
        socials.map(({ label, href, path }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            title={label}
            class="flex items-center justify-center p-1.5 text-faded transition-colors hover:text-gold"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
              <path d={path} />
            </svg>
          </a>
        ))
      }
    </nav>
  </div>
  <div class="mx-auto mt-5 flex w-full max-w-5xl flex-col items-center gap-5 px-6 pb-10 md:px-10">
    <p class="font-mono text-[9px] tracking-[0.15em] text-faded">
      CREATED WITH <span class="text-gold">{stack.join(" · ")}</span>
    </p>
    <p class="text-center font-mono text-[9px] tracking-[0.15em] text-faded">
      &copy; 2026 nickczak. All rights reserved. System state: Stable.
    </p>
  </div>
</footer>
