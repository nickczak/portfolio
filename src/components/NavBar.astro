---
interface Tab {
  label: string;
  href: string;
}

const tabs: Tab[] = [
  { label: "Home", href: "/" },
  { label: "Projects", href: "/projects" },
  { label: "Resume", href: "/resume" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  (href.replace(/\/$/, "") || "/") === currentPath;
---

<header class="relative sticky top-0 z-50 border-b border-charcoal bg-ink-black">
  <a
    href="/"
    aria-label="Home"
    class="absolute left-4 top-1/2 -translate-y-1/2 md:left-6"
  >
    <span
      class="flex h-11 w-11 items-center justify-center rounded-full bg-black font-quotex text-3xl leading-none text-gold transition-transform duration-200 hover:scale-105 md:h-12 md:w-12 md:text-4xl"
    >
      N
    </span>
  </a>

  <div class="mx-auto flex h-16 w-full max-w-5xl items-center justify-center px-6 md:px-10">
    <nav aria-label="Primary" class="flex items-stretch">
      {
        tabs.map(({ label, href }) => (
          <a
            href={href}
            aria-current={isActive(href) ? "page" : undefined}
            class={`flex items-center px-1.5 font-mono text-[10px] uppercase tracking-[0.2em] transition-colors duration-200 md:px-4 md:text-[11px] md:tracking-[0.25em] ${
              isActive(href)
                ? "border-b border-gold text-bone"
                : "border-b border-transparent text-faded hover:border-charcoal hover:text-gold"
            }`}
          >
            [ {label} ]
          </a>
        ))
      }
    </nav>
  </div>

  <div
    class="pointer-events-none absolute inset-x-0 top-full z-40"
    aria-hidden="true"
  >
    <div class="h-px w-full bg-parchment opacity-70"></div>
    <img
      src="/footer-rule.png"
      alt=""
      loading="lazy"
      class="mx-auto -mt-px block h-auto w-full max-w-xl -scale-y-100 select-none opacity-70"
    />
  </div>
</header>
