<section class="activity mx-auto w-full max-w-5xl px-6 pb-14 sm:px-10" aria-labelledby="activity-title" data-contributions>
  <div class="activity-heading">
    <div>
      <p class="eyebrow">[ The work between releases ]</p>
      <h2 id="activity-title">GitHub activity</h2>
    </div>
    <a href="https://github.com/nickczak" target="_blank" rel="noopener noreferrer">View GitHub <span aria-hidden="true">↗</span></a>
  </div>
  <div class="activity-panel">
    <div class="activity-summary">
      <p data-total>One year of building.</p>
      <span class="eyebrow">Last 12 months</span>
    </div>
    <p data-status role="status">Loading contribution history…</p>
    <div class="calendar-scroll" tabindex="0" role="region" aria-label="Contribution calendar; scroll horizontally on smaller screens" hidden>
      <div class="calendar">
        <div class="months" aria-hidden="true"></div>
        <div class="weekdays" aria-hidden="true"><span>Mon</span><span>Wed</span><span>Fri</span></div>
        <div class="days" role="group" aria-label="Daily contributions. Use arrow keys to explore dates."></div>
      </div>
    </div>
    <div class="activity-footer">
      <p data-detail aria-live="polite" aria-atomic="true">Hover, tap, or use arrow keys to explore.</p>
      <div class="legend" aria-label="Contribution intensity from less to more">
        <span>Less</span>
        {[0, 1, 2, 3, 4].map(level => <i data-level={level} aria-hidden="true"></i>)}
        <span>More</span>
      </div>
    </div>
    <noscript><p>Enable JavaScript to explore the calendar, or view the contribution history on GitHub.</p></noscript>
  </div>
</section>

<style>
  .activity { --activity-0: #191817; --activity-1: #443927; --activity-2: #75603b; --activity-3: #a2834d; --activity-4: var(--color-gold); }
  .activity-heading { display:flex; justify-content:space-between; align-items:end; gap:1.5rem; border-top:1px solid var(--color-charcoal); padding:2rem 0 1.5rem; }
  .eyebrow { font-size:.65rem; text-transform:uppercase; letter-spacing:.18em; color:var(--color-gold); }
  h2 { font-family:var(--font-gothic); font-size:clamp(1.8rem,4vw,2.25rem); color:var(--color-bone); margin-top:.6rem; }
  a { color:var(--color-faded); font-size:.75rem; white-space:nowrap; transition:color .2s; }
  a:hover { color:var(--color-gold); }
  a:focus-visible,.calendar-scroll:focus-visible { outline:1px solid var(--color-gold); outline-offset:5px; }
  .activity-panel { background:transparent; padding:1.5rem; }
  .activity-summary { display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:1.5rem; }
  [data-total] { font-family:var(--font-academic); font-size:1.35rem; color:var(--color-parchment); }
  [data-status] { color:var(--color-faded); font-size:.8rem; min-height:9rem; padding-top:2rem; }
  [hidden] { display:none !important; }
  .calendar-scroll { overflow-x:auto; padding:4px 4px 12px; scrollbar-width:thin; scrollbar-color:var(--color-charcoal) transparent; }
  .calendar { display:grid; grid-template-columns:30px 1fr; grid-template-rows:20px 1fr; gap:4px 8px; min-width:660px; }
  .months { grid-column:2; display:grid; font-size:.6rem; color:var(--color-faded); }
  .weekdays { display:grid; grid-template-rows:repeat(7,1fr); font-size:.6rem; color:var(--color-faded); align-items:center; }
  .weekdays span:nth-child(1) { grid-row:2; } .weekdays span:nth-child(2) { grid-row:4; } .weekdays span:nth-child(3) { grid-row:6; }
  .days { display:grid; grid-template-rows:repeat(7,1fr); grid-auto-flow:column; gap:4px; }
  .days :global(button),.legend i { background:var(--activity-0); border:1px solid #ffffff07; border-radius:2px; }
  .days :global(button) { width:100%; aspect-ratio:1; padding:0; cursor:pointer; opacity:1; }
  .days :global(button[data-level="1"]),.legend i[data-level="1"] { background:var(--activity-1); }
  .days :global(button[data-level="2"]),.legend i[data-level="2"] { background:var(--activity-2); }
  .days :global(button[data-level="3"]),.legend i[data-level="3"] { background:var(--activity-3); }
  .days :global(button[data-level="4"]),.legend i[data-level="4"] { background:var(--activity-4); }
  .days :global(button:hover),.days :global(button:focus-visible),.days :global(button[aria-pressed="true"]) { outline:1px solid var(--color-parchment); outline-offset:2px; box-shadow:0 0 10px #c9a86a55; z-index:1; }
  .activity-footer { display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-top:1rem; color:var(--color-faded); font-size:.65rem; }
  [data-detail] { min-height:2.5em; display:flex; align-items:center; }
  .legend { display:flex; align-items:center; gap:4px; white-space:nowrap; }
  .legend span:first-child { margin-right:4px; } .legend span:last-child { margin-left:4px; }
  .legend i { width:10px; height:10px; }
  @keyframes cell-reveal { from { opacity:0; transform:translateY(5px); } to { opacity:1; transform:translateY(0); } }
  @media (prefers-reduced-motion:no-preference) { .revealed .days :global(button) { animation:cell-reveal .45s ease-out both; animation-delay:var(--delay); } }
  @media (max-width:600px) { .activity-panel { padding:1rem; } .activity-summary,.activity-footer { align-items:start; flex-direction:column; gap:.6rem; } .activity-heading { align-items:center; } }
</style>

<script>
  type Day = { date: string; count: number; level: number };
  const root = document.querySelector<HTMLElement>('[data-contributions]');
  if (root) {
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const scroll = root.querySelector<HTMLElement>('.calendar-scroll')!;
    const daysGrid = root.querySelector<HTMLElement>('.days')!;
    const months = root.querySelector<HTMLElement>('.months')!;
    const detail = root.querySelector<HTMLElement>('[data-detail]')!;
    const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
    const monthFormat = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' });
    let selected: HTMLButtonElement | null = null;
    let visible = false;
    const reveal = () => { if (visible && daysGrid.childElementCount) root.classList.add('revealed'); };
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        if (entries.some(entry => entry.isIntersecting)) { visible = true; reveal(); observer.disconnect(); }
      }, { threshold: .15 });
      observer.observe(root);
    } else { visible = true; }

    async function load() {
      try {
        const response = await fetch('https://github-contributions-api.jogruber.de/v4/nickczak?y=last', { signal: AbortSignal.timeout(12000) });
        if (!response.ok) throw new Error('Contribution service unavailable');
        const data = await response.json();
        if (!Array.isArray(data.contributions) || !data.contributions.length) throw new Error('Missing contributions');
        const days: Day[] = data.contributions;
        if (!days.every(day => /^\d{4}-\d{2}-\d{2}$/.test(day.date) && Number.isFinite(Date.parse(day.date)) && Number.isInteger(day.count) && day.count >= 0 && Number.isInteger(day.level) && day.level >= 0 && day.level <= 4)) throw new Error('Invalid contribution data');
        days.sort((a, b) => a.date.localeCompare(b.date));
        const offset = new Date(`${days[0].date}T00:00:00Z`).getUTCDay();
        const columns = Math.ceil((offset + days.length) / 7);
        daysGrid.style.gridTemplateColumns = `repeat(${columns}, minmax(0,1fr))`;
        months.style.gridTemplateColumns = `repeat(${columns}, minmax(0,1fr))`;
        const fragment = document.createDocumentFragment();
        const buttons: HTMLButtonElement[] = [];
        let previousMonth = '';
        let previousMonthColumn = -4;
        days.forEach((day, index) => {
          const date = new Date(`${day.date}T00:00:00Z`);
          const column = Math.floor((index + offset) / 7);
          const month = day.date.slice(0, 7);
          if (month !== previousMonth && column - previousMonthColumn >= 3) {
            const label = document.createElement('span');
            label.textContent = monthFormat.format(date);
            label.style.gridColumn = `${column + 1} / span ${Math.min(3, columns - column)}`;
            months.append(label); previousMonthColumn = column; previousMonth = month;
          }
          const button = document.createElement('button');
          button.type = 'button'; button.dataset.level = String(day.level);
          button.style.gridColumn = String(column + 1);
          button.style.gridRow = String((index + offset) % 7 + 1);
          button.style.setProperty('--delay', `${column * 9}ms`);
          const label = `${day.count.toLocaleString()} ${day.count === 1 ? 'contribution' : 'contributions'} on ${dateFormat.format(date)}`;
          button.setAttribute('aria-label', label); button.setAttribute('aria-pressed', 'false');
          button.title = label; button.tabIndex = index === days.length - 1 ? 0 : -1;
          const describe = () => { detail.textContent = label; };
          button.addEventListener('pointerenter', describe);
          button.addEventListener('focus', () => {
            buttons.forEach(item => { item.tabIndex = item === button ? 0 : -1; }); describe();
          });
          button.addEventListener('click', () => {
            selected?.setAttribute('aria-pressed', 'false'); selected = button;
            button.setAttribute('aria-pressed', 'true'); describe();
          });
          button.addEventListener('keydown', event => {
            const moves: Record<string, number> = { ArrowLeft: -7, ArrowRight: 7, ArrowUp: -1, ArrowDown: 1 };
            let next = index;
            if (event.key in moves) next += moves[event.key];
            else if (event.key === 'Home') next = 0;
            else if (event.key === 'End') next = days.length - 1;
            else return;
            event.preventDefault(); buttons[Math.max(0, Math.min(days.length - 1, next))].focus();
          });
          buttons.push(button); fragment.append(button);
        });
        daysGrid.append(fragment);
        const total = days.reduce((sum, day) => sum + day.count, 0);
        root!.querySelector<HTMLElement>('[data-total]')!.textContent = `${total.toLocaleString()} contributions in the last year`;
        status.hidden = true; scroll.hidden = false;
        scroll.scrollLeft = scroll.scrollWidth;
        reveal();
      } catch {
        status.textContent = 'Contribution history is unavailable right now. You can still explore my work on GitHub.';
        root!.querySelector<HTMLElement>('.activity-footer')!.hidden = true;
      }
    }
    load();
  }
</script>
