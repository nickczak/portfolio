---
import "@fontsource-variable/cinzel";
import "@fontsource-variable/cormorant";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import GothicArch from "../components/graphics/GothicArch.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "NICHOLAS SOBCHAK — FULL-STACK ENGINEER",
  description = "Portfolio of Nicholas Sobchak. Full-Stack Engineer specializing in resilient system architecture and independent product delivery.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}/apple-touch-icon.png`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060504" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body class="relative min-h-full bg-ink-black text-parchment">
    <div
      class="pointer-events-none absolute inset-x-0 bottom-28 top-20 z-0 flex items-stretch justify-between gap-32 px-16 opacity-[0.05]"
      aria-hidden="true"
    >
      <div class="flex w-fit flex-col">
        <GothicArch class="h-[420px] w-auto text-gold" />
        <div class="relative grow self-stretch -mt-2">
          <span class="absolute inset-y-0 left-[12.5%] w-[1.5px] bg-gold"></span>
          <span class="absolute inset-y-0 left-[22.5%] w-[1.5px] bg-gold"></span>
          <span class="absolute inset-y-0 left-[49%] w-[1.5px] bg-gold"></span>
          <span class="absolute inset-y-0 right-[22.5%] w-[1.5px] bg-gold"></span>
          <span class="absolute inset-y-0 right-[12.5%] w-[1.5px] bg-gold"></span>
        </div>
      </div>

      <div class="hidden w-fit flex-col sm:flex">
        <GothicArch class="h-[380px] w-auto text-gold" />
        <div class="relative grow self-stretch -mt-2">
          <span class="absolute inset-y-0 left-[12.5%] w-[1.5px] bg-gold"></span>
          <span class="absolute inset-y-0 left-[22.5%] w-[1.5px] bg-gold"></span>
          <span class="absolute inset-y-0 left-[49%] w-[1.5px] bg-gold"></span>
          <span class="absolute inset-y-0 right-[22.5%] w-[1.5px] bg-gold"></span>
          <span class="absolute inset-y-0 right-[12.5%] w-[1.5px] bg-gold"></span>
        </div>
      </div>
    </div>
    <div class="relative z-10">
      <slot />
    </div>
    <div class="grain-overlay" aria-hidden="true"></div>
  </body>
</html>
