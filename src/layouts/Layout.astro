---
import "@fontsource-variable/cinzel";
import "@fontsource-variable/cormorant";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "NICHOLAS SOBCHAK — FULL-STACK ENGINEER",
  description = "Portfolio of Nicholas Sobchak. Full-Stack Engineer specializing in resilient system architecture and independent product delivery.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060504" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body class="min-h-full bg-ink-black text-parchment">
    <slot />
    <div class="grain-overlay" aria-hidden="true"></div>
  </body>
</html>
